includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 8
    bootstrapFiles:
        - phpstan-bootstrap.php
    # WP-CLI is not part of the WordPress stubs, and the seed command is real code
    # that has to be analysed like the rest. Scanned rather than excluded: a gate
    # that skips a file is a gate that reports success it did not earn.
    scanFiles:
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
    paths:
        - index.php
        - uninstall.php
        - app/
        - tools/
        - src/blocks/comparison-accordion/render.php
    excludePaths:
        - vendor/
        - node_modules/
        - build/
    ignoreErrors:
        # WordPress render.php templates receive $attributes as array<string, mixed>
        - identifier: missingType.iterableValue
        # wp_insert_post() PHPDoc says int but can return WP_Error with wp_error=true default
        -
            identifier: function.impossibleType
            path: tools/import-html-data.php