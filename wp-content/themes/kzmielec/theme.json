{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultPalette": true,
			"defaultGradients": false,
			"gradients": [
				{
				  "slug": "gradient-to-left-bottom",
				  "gradient": "linear-gradient(to left bottom, #000 0%, #333 100%)",
				  "name": "Gradient to Left Bottom"
				},
				{
				  "slug": "gradient-to-bottom",
				  "gradient": "linear-gradient(to bottom, #000 0%, #333 100%)",
				  "name": "Gradient to Bottom"
				}
			],
			"palette": [
				{
					"color": "#ffffff",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#000000",
					"name": "Site Color",
					"slug": "site-color"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fluid": false,
			"fontFamilies": [
				{
					"fontFamily": "'Cinzel', serif",
					"name": "Cinzel",
					"slug": "cinzel",
					"fontFace": [
						{
							"fontFamily": "Cinzel",
							"fontWeight": "400 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/webfont/cinzel-v26-latin-ext.woff2",
								"file:./assets/webfont/cinzel-v26-latin.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"name": "Display",
					"size": "2.5rem",
					"slug": "display"
				},
				{
					"name": "Heading",
					"size": "2rem",
					"slug": "heading"
				},
				{
					"name": "Subheading",
					"size": "1.75rem",
					"slug": "subheading"
				},
				{
					"name": "Title",
					"size": "1.5rem",
					"slug": "title"
				},
				{
					"name": "Body",
					"size": "1.25rem",
					"slug": "body"
				},
				{
					"name": "Body small",
					"size": "1.125rem",
					"slug": "body-sm"
				},
				{
					"name": "Base",
					"size": "1rem",
					"slug": "base"
				},
				{
					"name": "Meta",
					"size": "0.875rem",
					"slug": "meta"
				},
				{
					"name": "Small",
					"size": "0.75rem",
					"slug": "small"
				},
				{
					"name": "Extra small",
					"size": "0.625rem",
					"slug": "xs"
				}
			],
			"writingMode": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "100%"
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "Georgia, 'Times New Roman', 'Liberation Serif', serif"
		}
	}
}
