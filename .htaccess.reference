# Reference copy of the hand-written .htaccess rules.
#
# The live .htaccess is NOT in version control. WordPress rewrites its own
# section, LiteSpeed Cache writes and withdraws two more, and the file therefore
# changes without anybody editing it -- which made every `git status` dirty and
# invited a commit of one machine's cache settings. Deployment never touches the
# document root either (only the theme, the plugins and scripts/ go over rsync),
# so the file in the repository was never the file being served.
#
# What is versioned is this: the rules we wrote ourselves, so they can be
# reviewed, and so a lost .htaccess can be rebuilt without archaeology.
#
# Applying it: paste the blocks below into the live .htaccess ABOVE
# `# BEGIN WordPress`, keeping the generated sections untouched. Order matters
# only in that our rules must sit outside the generated markers -- anything
# between them is overwritten without warning.
#
# Not reproduced here, because they are generated and self-repairing:
#   # BEGIN WordPress ... # END WordPress          (core, via flush_rewrite_rules)
#   # BEGIN LSCACHE ... # END LSCACHE              (LiteSpeed Cache plugin)
#   # BEGIN NON_LSCACHE ... # END NON_LSCACHE      (LiteSpeed Cache plugin)
#
# This repository is public, so this file states what the rules do and stops
# there. Which of them the hosting layer honours, what is deliberately not set
# and why, and the open question with the host are in the operator note kept
# outside the repository -- a public list of a site's soft spots is a favour to
# nobody.

# BEGIN SECURITY HEADERS
# Deliberately kept OUTSIDE the sections managed by plugins and by core
# (LSCACHE, NON_LSCACHE, WordPress): those are rewritten automatically, this one
# is left alone.
#
# When testing: LiteSpeed caches its read of .htaccess for about two minutes, so
# a freshly added header does not show up at once. Absence right after saving is
# not yet a misconfiguration.
<IfModule mod_headers.c>
	# Do not guess a file's type against its Content-Type. Every uploaded SVG
	# already passes through the svg-sanitize library; this is the second lock on
	# that door.
	Header always set X-Content-Type-Options "nosniff"

	# The page may not be framed on a foreign domain (clickjacking). Safe to set:
	# the site frames nothing of its own, and the Facebook and Instagram embeds
	# are outbound traffic, which this does not cover. Core sends this header on
	# the login screen only, so ours covers the front end and the admin too.
	Header always set X-Frame-Options "SAMEORIGIN"

	# Leaving for a foreign domain sends the domain only, not the address of the
	# page the visitor came from. It earns its place the day analytics is added.
	Header always set Referrer-Policy "strict-origin-when-cross-origin"

	# Browser APIs the site does not use. Verified: no navigator.geolocation and
	# no navigator.mediaDevices anywhere in the code, and the Leaflet map shows a
	# fixed marker without asking for the visitor's location. The point is that a
	# hijacked plugin could not even ASK for the camera.
	Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"

	# HSTS: the browser reaches for HTTPS without asking the server. The redirect
	# below only helps AFTER a first request has travelled unencrypted, which is
	# why both exist.
	#
	# max-age is deliberately short (one day). This header cannot be withdrawn
	# quickly: browsers honour the remembered value regardless of what the server
	# sends later. Raise it to a year (31536000) only after a week without
	# trouble.
	Header always set Strict-Transport-Security "max-age=86400"
</IfModule>
# END SECURITY HEADERS

# BEGIN CORE FINGERPRINT
# readme.html prints the exact WordPress version in its headline; the other two
# confirm the platform. Denied rather than only deleted, because a core update
# restores readme.html and license.txt every time and this block survives it.
<FilesMatch "^(readme\.html|license\.txt|wp-config-sample\.php)$">
	Require all denied
</FilesMatch>
# END CORE FINGERPRINT

# BEGIN HOSTING
# Host-specific: the PHP handler is selected per directory, and the default
# memory limit is too low for the admin with Yoast and LiteSpeed active.
AddHandler application/x-httpd-php81 php
php_value memory_limit 256M
# END HOSTING

# BEGIN HTTPS
# Redirect HTTP to HTTPS.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
# END HTTPS
