.DS_Store
Thumbs.db

# DDEV — per-machine config stays out, but the custom commands are the project's
# build entry points and belong in version control. They were ignored wholesale,
# so `ddev build:all` and friends existed only on whichever machine had typed them
# in, and the docs told you to recreate them by hand after a clone. A build script
# that is not in the repository cannot be reviewed, and cannot be fixed once.
# `.ddev/*` (not `.ddev/`) is required: git cannot re-include anything inside a
# directory that is itself excluded.
.ddev/*
!.ddev/commands/
.ddev/commands/*/README.txt

# Database dumps
*.sql
*.sql.gz

# Wordfence
wordfence-waf.php
wp-content/wflogs/

# Cache drop-ins & runtime data (LiteSpeed Cache, legacy WP Super Cache/Autoptimize)
wp-content/cache/
wp-content/advanced-cache.php
wp-content/object-cache.php
wp-content/autoptimize_404_handler.php
wp-content/wp-cache-config.php
# LiteSpeed Cache runtime data & .htaccess backups (per-machine, plugin-generated)
wp-content/litespeed/
.htaccess.bk
.litespeed_conf.dat

# The live .htaccess is written by three parties: core rewrites its own section,
# LiteSpeed Cache adds and withdraws two more, and we hand-write the rest. Only
# the hand-written part is worth reviewing, so it lives in `.htaccess.reference`
# and the file itself stays out. Nothing is lost by that: deployment rsyncs the
# theme, the plugins and scripts/, never the document root, so the tracked copy
# was never the copy being served. Leading slash on purpose -- LiteSpeed Cache
# ships an .htaccess of its own that must stay tracked.
/.htaccess

# readme.html prints the exact WordPress version in its headline, which is the
# cheapest way to end up on an automated list of targets. It is deleted from
# production and denied in .htaccess; ignoring it here keeps a core update from
# putting it back. Note this hides a fingerprint on the server, not in the
# repository -- wp-includes/version.php is tracked and states the version
# outright.
/readme.html

# Misc
htaccess.htaccess

# CCE (code-context-engine)
# CCE local cache (per-machine, not for version control)
.cce/
# Claude Code local settings written by cce init
.claude/settings.local.json
# Same reason: this one wires hooks to an absolute path under the user's home
# (/home/<user>/.cce/hooks/…), which exists on exactly one machine.
.claude/settings.json
# .mcp.json contains absolute paths regenerated by `cce init`
.mcp.json

# Project notes and the environment inventory stay out: they carry the production
# host, login and paths, and this repository is public. They are kept locally
# instead, and credentials outside any repository.
.claude/project-config.md
.claude/NAGLOWKI-BEZPIECZENSTWA.md

# Working notes and plans, out of the repository for now. Documentation written
# for the repository will be in English, and then this entry either goes away or
# gains an exception for the chosen files.
docs/

# Translation packs that WordPress manages itself. It downloads and updates them
# on its own schedule, so the repository only ever holds a stale copy: on
# 2026-08-18 production had 1082 strings for the Instagram feed in en_GB where
# the tracked file had 192. Restore on a fresh install with
# `wp language core install pl_PL en_GB uk es_ES` and
# `wp language plugin update --all`.
#
# One exception stays tracked, and it matters: the Ukrainian pack for the
# Instagram feed is written by hand, because translate.wordpress.org has none.
# Nothing would bring that file back.
/wp-content/languages/*
!/wp-content/languages/plugins/
/wp-content/languages/plugins/*
!/wp-content/languages/plugins/instagram-feed-uk.l10n.php
!/wp-content/languages/plugins/instagram-feed-uk.mo
!/wp-content/languages/plugins/instagram-feed-uk.po
