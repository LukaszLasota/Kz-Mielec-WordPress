#!/bin/bash
# Two jobs, in this order:
#   1. refuse the commit if it carries production access data or a secret,
#   2. rebuild theme assets when theme source is staged.
#
# The guard exists because this repository has been PUBLIC on GitHub since its first
# commit, and the production SSH host, port, username, database name and server path were
# published in it for a week before anyone noticed. No credential ever leaked — wp-config.php
# was never tracked — but host plus username is half of an SSH login, and it cost nothing to
# add. A rule nobody enforces is a wish; this one is enforced by the tool.
#
# Access data belongs in ~/private/connection-details.txt, outside every repository.
set -e

# --- 1. Secret and access-data guard ---------------------------------------------

staged=$(git diff --cached --name-only --diff-filter=ACM)

if [ -n "$staged" ]; then
	# Patterns are deliberately narrow: a guard that cries wolf gets bypassed with
	# --no-verify and then protects nothing.
	#
	# The patterns are ERE (grep -E): a parenthesis must be escaped, and repetition is
	# written {n,} without backslashes. The first version mixed both syntaxes and grep
	# answered "Unmatched ( or \(" -- meaning some patterns were not working at all,
	# while the hook still exited successfully. A guard that silently checks nothing is
	# worse than no guard.
	#
	# The strings specific to this project -- the SSH host and the username -- are NOT
	# here. The first version of this hook spelled them out and immediately blocked its
	# own commit, which was the correct answer to a file that discloses what it forbids.
	# They live in ~/private/git-forbidden-strings.txt: one per line, outside every
	# repository, shared by every project on this machine.
	patterns=(
		'BEGIN [A-Z ]*PRIVATE KEY'
		# A Facebook page token runs to about 200 characters, so 100 is still well
		# under a real one while cutting the odds of matching a base64 blob.
		'EAA[A-Za-z0-9]{100,}'
		'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:fx'
		"define\\([[:space:]]*'DB_PASSWORD'[[:space:]]*,[[:space:]]*'[^']{4,}'"
		# The value has to look like a literal rather than code or a placeholder: the first
		# character may not be $ " \ < ' or a space. Without that, the hook flagged
		# documentation where `password=" . $v["DB_PASSWORD"]` merely READS the password at
		# run time -- which is the pattern to copy, not a leak.
		#
		# Both spellings of the Polish word are matched on purpose: the notes are written in
		# Polish even though everything committed is in English.
		'(hasło|haslo|password)[[:space:]]*[:=][[:space:]]*[A-Za-z0-9!@#%^&*_+=-]{6,}'
	)

	# The strings from the private file are appended to the list. Its absence is a warning,
	# not silent consent: a hook that does not know what to look for and says nothing is
	# worse than no hook.
	forbidden_file="$HOME/private/git-forbidden-strings.txt"

	if [ -r "$forbidden_file" ]; then
		while IFS= read -r line; do
			case "$line" in
				''|'#'*) continue ;;
			esac
			patterns+=("$line")
		done < "$forbidden_file"
	else
		echo "pre-commit: WARNING -- $forbidden_file is missing, checking generic patterns only." >&2
	fi

	# Strings that look like a secret and are not one. Each is listed deliberately, with a
	# reason: a list of exceptions without justifications turns into a list of everything.
	allow=(
		'12ab34cd-5e6f-7890-abcd-ef1234567890'   # fictional DeepL key, in a test and in the docs
		'password_here'                          # placeholder from wp-config-sample.php
	)

	hits=""

	for file in $staged; do
		[ -f "$file" ] || continue

		# Binaries and build output are not where secrets are typed by hand.
		case "$file" in
			*.png|*.jpg|*.jpeg|*.webp|*.avif|*.gif|*.ico|*.woff|*.woff2|*.ttf|*.eot|*.zip|*.gz|*.mo) continue ;;
			*/node_modules/*|*/vendor/*|*/build/*|wp-admin/*|wp-includes/*) continue ;;
			# Third-party plugins, for the same reason as core: we do not type
			# anything into them, we only update them. Their minified assets embed
			# base64 fonts and SVG blobs, and base64 is random alphanumerics -- so
			# a token-shaped pattern lands in them by chance. Updating three
			# plugins on 2026-08-12 blocked its own commit twice this way.
			wp-content/plugins/litespeed-cache/*|wp-content/plugins/instagram-feed/*) continue ;;
			wp-content/plugins/wordpress-seo/*|wp-content/plugins/polylang/*) continue ;;
		esac

		content=$(git show ":$file" 2>/dev/null || true)

		for pattern in "${patterns[@]}"; do
			match=$(printf '%s' "$content" | grep -nE "$pattern" | head -1 || true)

			[ -n "$match" ] || continue

			# A known, justified exception? Then it is not a hit.
			skip=""
			for safe in "${allow[@]}"; do
				case "$match" in
					*"$safe"*) skip="yes" ;;
				esac
			done

			[ -n "$skip" ] && continue

			hits="${hits}  ${file}: $(printf '%s' "$match" | cut -c1-70)\n"
			break
		done
	done

	if [ -n "$hits" ]; then
		echo "" >&2
		echo "pre-commit: STOPPED -- the staged changes carry data that must not enter the repository." >&2
		echo "" >&2
		printf '%b' "$hits" >&2
		echo "" >&2
		echo "  This repository is public. Access data is kept outside it, and documents" >&2
		echo "  refer to the deployment target as \$PRODHOST/\$PRODUSER." >&2
		echo "" >&2
		echo "  If this is a false alarm (a description of a bug, say), narrow the pattern in" >&2
		echo "  .githooks/pre-commit rather than going around the hook with --no-verify." >&2
		echo "" >&2
		exit 1
	fi
fi

# --- 2. Theme assets -------------------------------------------------------------
# Rebuild theme assets when theme source/config is staged, so committed assets are
# always the optimized build. Skips when nothing theme-related is staged.

THEME="wp-content/themes/kzmielec"
if git diff --cached --name-only | grep -qE "^${THEME}/(src/|webpack\.config\.js|package\.json|tsconfig\.json)"; then
	echo "pre-commit: theme source staged → building assets…"
	if ! ddev theme:build >/dev/null 2>&1; then
		echo "pre-commit: 'ddev theme:build' failed (is ddev running?). Aborting commit." >&2
		exit 1
	fi
	git add "${THEME}/assets"
	echo "pre-commit: assets rebuilt and staged."
fi
