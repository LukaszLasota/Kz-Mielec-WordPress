# BEGIN NAGŁÓWKI BEZPIECZEŃSTWA
# Blok trzymany celowo POZA sekcjami zarządzanymi przez wtyczki i rdzeń
# (LSCACHE, NON_LSCACHE, WordPress) — tamte są przepisywane automatycznie,
# ten nie jest ruszany.
#
# Uwaga przy testowaniu: LiteSpeed buforuje odczyt .htaccess przez ok. 2 minuty,
# więc świeżo dodany nagłówek nie pojawia się od razu. Brak nagłówka zaraz po
# zapisie to jeszcze nie błąd konfiguracji.
<IfModule mod_headers.c>
	# Nie zgaduj typu pliku wbrew Content-Type — blokuje atak polegający na
	# podaniu skryptu jako obrazka.
	Header always set X-Content-Type-Options "nosniff"

	# Strony nie wolno osadzić w ramce na obcej domenie (clickjacking).
	# Bezpieczne: strona nie zawiera ani jednego <iframe>, a osadzenia
	# Facebooka i Instagrama są ruchem wychodzącym, którego to nie dotyczy.
	Header always set X-Frame-Options "SAMEORIGIN"

	# Przy przejściu na obcą domenę wysyłamy samą domenę, nie pełny adres
	# podstrony, z której użytkownik wyszedł.
	Header always set Referrer-Policy "strict-origin-when-cross-origin"

	# Wyłączone API przeglądarki, z których strona nie korzysta — sprawdzone,
	# w kodzie nie ma navigator.geolocation ani navigator.mediaDevices. Mapa
	# Leaflet pokazuje stały znacznik i nie pyta o lokalizację użytkownika.
	Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"

	# HSTS: przeglądarka sama używa HTTPS, bez pytania serwera. max-age celowo
	# krótki (1 doba) — tego nagłówka nie da się szybko odwołać, bo przeglądarki
	# pamiętają go przez zadany czas niezależnie od tego, co serwer wyśle
	# później. Do roku (31536000) podnosimy dopiero po tygodniu bez problemów.
	Header always set Strict-Transport-Security "max-age=86400"
</IfModule>
# END NAGŁÓWKI BEZPIECZEŃSTWA

AddHandler application/x-httpd-php81 php
php_value memory_limit 256M

# Przekierowanie HTTP na HTTPS
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# BEGIN WordPress
# Dyrektywy zawarte między "BEGIN WordPress" oraz "END WordPress"
# są generowane dynamicznie i powinny być modyfikowane tylko za pomocą
# filtrów WordPressa. Zmiany dokonane bezpośrednio tutaj będą nadpisywane.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress
